DJANGO_SECRET_KEY=clave-super-segura-123
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,micro_calificaciones,micro_calificaciones:8001,0.0.0.0

# ========================
# 🗄️ Base de datos PostgreSQL
# ========================
